#!/bin/sh

PREREQS="plymouth"

prereqs() { echo "$PREREQS"; }

case "$1" in
  prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

PLUGIN_DIR=/usr/lib/aarch64-linux-gnu/plymouth
THEME_DIR=/usr/share/plymouth/themes/writerdeck

if [ -d "${THEME_DIR}" ]; then
  mkdir -p "${DESTDIR}${THEME_DIR}"
  cp -a "${THEME_DIR}/." "${DESTDIR}${THEME_DIR}/"
fi

for plugin in script.so label-pango.so label-freetype.so; do
  if [ -f "${PLUGIN_DIR}/${plugin}" ]; then
    copy_exec "${PLUGIN_DIR}/${plugin}"
  fi
done

# The DRM renderer maps the vc4 GPU's CMA region (~256MB) multiple times,
# crashing Plymouth on a 512MB Pi Zero 2W. Remove it so Plymouth uses
# frame-buffer.so instead, which maps /dev/fb0 directly (~2.4MB).
rm -f "${DESTDIR}/usr/lib/aarch64-linux-gnu/plymouth/renderers/drm.so"
