#!/usr/bin/env python3
"""WriterDeck command line tool."""

from __future__ import annotations

import argparse
import datetime as dt
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover - Python <3.11 fallback
    print("error: Python 3.11+ is required (tomllib missing)", file=sys.stderr)
    sys.exit(2)

DEFAULT_CONFIG_PATH = Path("/etc/writerdeck/config.toml")


class WriterDeckError(RuntimeError):
    """Raised when writerdeck commands cannot complete."""


class Config:
    def __init__(self, raw: dict):
        self.root = Path(_read_required(raw, "paths", "root")).expanduser()
        self.default_project = _sanitize_name(
            _read_required(raw, "paths", "default_project"), "project"
        )
        self.editor_command = _read_required(raw, "editor", "command")


def _read_required(raw: dict, section: str, key: str):
    section_data = raw.get(section)
    if not isinstance(section_data, dict):
        raise WriterDeckError(f"missing [{section}] section in config")

    if key not in section_data:
        raise WriterDeckError(f"missing required config key: {section}.{key}")

    return section_data[key]


def _load_config(path: Path) -> Config:
    if not path.exists():
        raise WriterDeckError(f"config file not found: {path}")

    with path.open("rb") as handle:
        raw = tomllib.load(handle)

    return Config(raw)


def _sanitize_name(value: str, kind: str) -> str:
    cleaned = re.sub(r"[^a-zA-Z0-9._-]+", "-", value.strip().lower()).strip("-._")
    if not cleaned:
        raise WriterDeckError(f"{kind} name cannot be empty after sanitization")
    return cleaned


def _timestamp_now() -> str:
    return dt.datetime.now().strftime("%Y-%m-%d_%H%M")


def _find_latest_draft(root: Path) -> Path | None:
    if not root.exists():
        return None

    files = [path for path in root.rglob("*.wg") if path.is_file()]
    if not files:
        return None

    return max(files, key=lambda path: path.stat().st_mtime)


def _wd_export_lua_path() -> Path:
    path = Path(__file__).resolve().parent.parent / "scripts" / "wd-export.lua"
    if not path.exists():
        raise WriterDeckError(f"wd-export.lua not found: {path}")
    return path


def _find_all_drafts(root: Path) -> list[Path]:
    if not root.exists():
        return []
    return sorted(path for path in root.rglob("*.wg") if path.is_file())


def _export_wg(wg_path: Path) -> list[Path]:
    lua_script = _wd_export_lua_path()
    tmpdir = Path(tempfile.mkdtemp())
    try:
        result = subprocess.run(
            ["wordgrinder", "--lua", str(lua_script), str(wg_path), str(tmpdir)],
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode != 0:
            raise WriterDeckError(
                f"export failed for {wg_path}: {result.stderr.strip()}"
            )
        docs = []
        for line in result.stdout.splitlines():
            if "\t" not in line:
                continue
            docname, txtpath = line.split("\t", 1)
            docs.append((docname, Path(txtpath)))

        if not docs:
            raise WriterDeckError(f"no documents exported from {wg_path}")

        combined = []
        for docname, txtpath in docs:
            text = txtpath.read_text(encoding="utf-8").rstrip()
            combined.append(f"# {docname}\n\n{text}")

        exports_dir = wg_path.parent / "exports"
        exports_dir.mkdir(exist_ok=True)
        out_path = exports_dir / f"{wg_path.stem}.txt"
        out_path.write_text("\n\n".join(combined) + "\n", encoding="utf-8")
        return [out_path]
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def _create_new_draft(root: Path, project: str, slug: str | None = None) -> Path:
    root.mkdir(parents=True, exist_ok=True)
    project_name = _sanitize_name(project, "project")
    slug_name = _sanitize_name(slug or "draft", "slug")

    project_dir = root / project_name
    project_dir.mkdir(parents=True, exist_ok=True)

    timestamp = _timestamp_now()
    draft_path = project_dir / f"{timestamp}_{slug_name}.wg"
    counter = 2
    while draft_path.exists():
        draft_path = project_dir / f"{timestamp}_{slug_name}-{counter}.wg"
        counter += 1

    return draft_path


def _run_editor(
    editor_command: str, files: list[Path] | None = None, cwd: Path | None = None
) -> int:
    cmd = shlex.split(editor_command)
    if not cmd:
        raise WriterDeckError("editor.command is empty")

    cmd.extend(str(path) for path in files or [])
    return subprocess.run(cmd, cwd=cwd, check=False).returncode


def _is_wordgrinder_command(editor_command: str) -> bool:
    cmd = shlex.split(editor_command)
    if not cmd:
        return False
    return Path(cmd[0]).name in {"wordgrinder", "xwordgrinder"}


def cmd_open_latest(cfg: Config, _args: argparse.Namespace) -> int:
    latest = _find_latest_draft(cfg.root)
    if latest is None:
        if _is_wordgrinder_command(cfg.editor_command):
            cfg.root.mkdir(parents=True, exist_ok=True)
            return _run_editor(cfg.editor_command)
        latest = _create_new_draft(cfg.root, cfg.default_project, "draft")

    return _run_editor(cfg.editor_command, [latest])


def cmd_new(cfg: Config, args: argparse.Namespace) -> int:
    folder = args.folder or cfg.default_project
    if _is_wordgrinder_command(cfg.editor_command):
        project_name = _sanitize_name(folder, "folder")
        project_dir = cfg.root / project_name
        project_dir.mkdir(parents=True, exist_ok=True)
        print(
            "Opening a blank WordGrinder document. "
            f"Save it under: {project_dir}"
        )
        return _run_editor(cfg.editor_command, cwd=project_dir)

    draft = _create_new_draft(cfg.root, folder)
    return _run_editor(cfg.editor_command, [draft])


def cmd_projects(cfg: Config, _args: argparse.Namespace) -> int:
    cfg.root.mkdir(parents=True, exist_ok=True)
    projects = sorted(path.name for path in cfg.root.iterdir() if path.is_dir())
    for project in projects:
        print(project)
    return 0


def cmd_export(cfg: Config, args: argparse.Namespace) -> int:
    if args.path and args.all:
        print("error: 'path' and '--all' are mutually exclusive", file=sys.stderr)
        return 1

    if args.all:
        targets = _find_all_drafts(cfg.root)
        if not targets:
            print("error: no .wg files found under", cfg.root, file=sys.stderr)
            return 1
    elif args.path:
        targets = [Path(args.path)]
    else:
        latest = _find_latest_draft(cfg.root)
        if latest is None:
            print("error: no .wg files found", file=sys.stderr)
            return 1
        targets = [latest]

    default_invocation = not args.path and not args.all

    for wg_path in targets:
        print(f"Exporting: {wg_path}")
        try:
            output_paths = _export_wg(wg_path)
        except WriterDeckError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 1
        for out in output_paths:
            print(f"  → {out}")

    if default_invocation:
        print(
            "Tip: run 'wd export <path>' to export a specific file,"
            " 'wd export --all' for everything."
        )

    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="WriterDeck CLI")
    parser.add_argument(
        "--config",
        default=os.getenv("WD_CONFIG", str(DEFAULT_CONFIG_PATH)),
        help="Path to writerdeck TOML config (default: /etc/writerdeck/config.toml)",
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    open_latest = subparsers.add_parser("open-latest", help="Open most recent draft")
    open_latest.set_defaults(func=cmd_open_latest)

    new_cmd = subparsers.add_parser("new", help="Open a new draft in a folder")
    new_cmd.add_argument("folder", nargs="?", help="Folder name (default: config default_project)")
    new_cmd.set_defaults(func=cmd_new)

    projects = subparsers.add_parser("projects", help="List project folders")
    projects.set_defaults(func=cmd_projects)

    export_cmd = subparsers.add_parser("export", help="Export drafts to TXT")
    export_cmd.add_argument("path", nargs="?", help="Path to a .wg file (default: most recent)")
    export_cmd.add_argument("--all", action="store_true", dest="all", help="Export all .wg files under the writing root")
    export_cmd.set_defaults(func=cmd_export)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    try:
        cfg = _load_config(Path(args.config).expanduser())
        return args.func(cfg, args)
    except WriterDeckError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
