#!/bin/sh
# Thin wrapper: handles non-interactive TTY detection, then delegates to wd-menu.
set -eu

while true; do
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        # Non-interactive (e.g. SSH without TTY): skip menu, open editor directly.
        wd open-latest || true
        sleep 1
        continue
    fi
    wd-menu || sleep 1
done
